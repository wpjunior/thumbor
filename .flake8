[flake8]
# E704 is in pycodestyle's own default ignore list; `select = E` below
# re-enables it. It fires on the `def f() -> T: ...` bodies that black
# produces for Protocol members and stubs.
ignore = W801,E501,W605,W504,W606,W503,E203,E266,E704
max-line-length = 88
max-complexity = 20
select = B,C,E,F,W,T4
exclude = ./.tox/*,./.venv/*,./.uv-venv/*,./build/*,./docs/conf.py,./.env
